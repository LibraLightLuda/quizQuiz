{
  "name": "numbercal-learning-playground",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/build-pages.mjs && playwright test --config=playwright.pwa.config.ts",
    "test:budget": "npm run build && node scripts/check-build-budget.mjs",
    "optimize:story-images": "node scripts/optimize-story-images.mjs",
    "validate:data": "npm run validate:content",
    "validate:content": "vitest run src/domain/dataValidation.test.ts src/domain/skillData.test.ts src/domain/contentQuality.test.ts src/story/storyData.test.ts src/visuals/visualAssets.test.ts",
    "report:content": "node scripts/content-quality-report.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
